{
    "name": "rezakl/cpanel-php",
    "description": "Lightweight cURL-based client for the cPanel/WHM JSON API",
    "license": "MIT",
    "keywords": ["cpanel", "whm", "api", "hosting"],
    "authors": [
        {
            "name": "Rezakl"
        }
    ],
    "require": {
        "php": ">=5.5",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6"
    },
    "autoload": {
        "psr-0": {
            "Rezakl\\CpanelPhp\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
